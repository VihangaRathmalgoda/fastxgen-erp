{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576,
      "MaxRequestHeadersTotalSize": 32768
    }
  },
  "Database": {
    "ConnectionString": "",
    "CommandTimeoutSeconds": 30
  },
  "RateLimiting": {
    "PermitsPerMinute": 300
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
